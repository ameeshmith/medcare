# ============================================================================
# MedGridOS - AI Healthcare Operations Agent Configuration
# ============================================================================

# LLM Inference (Groq API - Llama 3.3 70B Versatile)
# Get your free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database (PostgreSQL primary; automatically falls back to local SQLite if offline)
DATABASE_URL=postgresql://medgrid:medgrid_pass@localhost:5432/medgrid_hospital
SQLITE_FALLBACK_URL=sqlite:///./medgrid_hospital.db

# Vector Database & Embeddings
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# n8n Workflow Orchestration & Webhooks
N8N_BASE_URL=http://localhost:5678
N8N_ORCHESTRATOR_WEBHOOK=http://localhost:5678/webhook/medgrid-orchestrator
N8N_REMINDER_WEBHOOK=http://localhost:5678/webhook/medgrid-reminders
N8N_DAILY_REPORT_WEBHOOK=http://localhost:5678/webhook/medgrid-daily-report

# Email Notifications (configured inside n8n or FastAPI SMTP bridge)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@medgrid-hospital.org
SMTP_FROM=MedGrid Operations <notifications@medgrid-hospital.org>

